# Local dev (default): Vite proxies /api/* to http://127.0.0.1:3000
# Remote AWS mode via SSH tunnel (recommended — keeps Consul 8500 & Azure 8001 private):
#   ssh -N -L 3001:127.0.0.1:3000 -i <aws-key.pem> ubuntu@<AWS_PUBLIC_IP>
#   VITE_GATEWAY_PROXY_TARGET=http://127.0.0.1:3001
# Direct AWS Gateway URL (only if port 3000 is open in AWS Security Group):
#   VITE_API_BASE_URL=http://<AWS_PUBLIC_IP>:3000
VITE_API_BASE_URL=
VITE_GATEWAY_PROXY_TARGET=http://127.0.0.1:3000
